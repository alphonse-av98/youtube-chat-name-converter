{
  "manifest_version": 3,
  "name": "YouTube Chat Name Converter",
  "version": "1.0.0",
  "description": "A Chrome extension that converts YouTube handles (e.g., @user-id) back to original channel names in the live chat.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/handle.js",
        "src/shared/storage.js",
        "src/content/cache.js",
        "src/content/fetcher.js",
        "src/content/chat.js",
        "src/content/main.js"
      ],
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"]
}
